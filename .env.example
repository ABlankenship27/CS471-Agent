# Copy this file to .env and fill in what your capstone actually needs.
# .env is gitignored; .env.example is committed. Never commit real keys.
#
# The starter agent defaults to a LOCAL Hugging Face model, which needs NO key -
# the first run downloads the weights into the Hugging Face cache. Set this only
# to switch models (or remove it and swap the adapter for a hosted provider).

# --- Local model (default path; no key needed) ---
# Any Hugging Face chat model id works. On a CPU-only machine pick a smaller
# model, e.g. Qwen/Qwen2.5-1.5B-Instruct.
FAIR_LLM_DEMO_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Hosted providers (optional; uncomment if you swap the adapter) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Framework settings ---
# Framework-level knobs (dispatch caps, resilience, streaming, RAG, ...) live
# in settings.yml - copy settings.example.yml and edit. Do NOT set
# FAIR_LLM_SETTINGS here: fairlib reads it at import time, before .env loads.
